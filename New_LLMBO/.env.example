# LLM API Configuration
# Copy this file to .env and fill in your values
#
# Supported providers:
#   - OpenAI (api.openai.com)
#   - OpenAI-compatible (minimax-m2.7, groq, deepseek, etc.)

# Required: API key
LLM_API_KEY=your_api_key_here

# API base URL (OpenAI-compatible endpoint)
# Examples:
#   https://api.nuwaapi.com/v1      (Nuwa)
#   https://api.minimax.chat/v1     (Minimax)
#   https://openrouter.ai/api/v1     (OpenRouter)
LLM_API_BASE=https://api.minimax.chat/v1

# Model name (OpenAI-compatible)
LLM_MODEL=minimax-4o-mini

# Optional: Sampling temperature (0.0-2.0, default: 0.7)
# LLM_TEMPERATURE=0.7
